# Feste Pool-Einstellungen für den Beta-Server. Zugangsdaten und Adressen kommen aus .env (docker-compose.yml).
NETWORK=mainnet

BITCOIN_RPC_URL=http://bitcoind
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_TIMEOUT=30000
BITCOIN_RPC_COOKIEFILE=
BITCOIN_ZMQ_HOST=tcp://bitcoind:28332

API_PORT=3334
API_SECURE=false
STRATUM_PORT=3333
STRATUM_MAX_CONNECTIONS_PER_LISTENER=2000

# Merged Mining mit Doichain
AUXPOW_ENABLED=true
DOICHAIN_RPC_URL=http://doichaind
DOICHAIN_RPC_PORT=8339
DOICHAIN_RPC_TIMEOUT=30000
DOICHAIN_RPC_COOKIEFILE=
# statisches Doichain-Binary ohne ZMQ: neue Blöcke per Polling
DOICHAIN_POLL_INTERVAL_MS=3000
DOICHAIN_AUXBLOCK_REFRESH_MS=15000

# /api/health vergleicht die eigenen Nodes mit öffentlichen Höhen (alle 5 Minuten abgefragt, "off" schaltet ab)
BITCOIN_PUBLIC_HEIGHT_URL=https://mempool.space/api/blocks/tip/height
DOICHAIN_PUBLIC_HEALTH_URL=https://doi-api.sendlabs.de/health

# Telegram-Offline-Alarm: Minuten ohne Share oder Heartbeat, bis ein Worker als offline gemeldet wird (0 schaltet ab)
OFFLINE_ALERT_MINUTES=10

# Beta-Server: nach deploy/.env kopieren und ausfüllen. install.sh erzeugt die Passwörter automatisch.

# Domain, auf die der A-Record des Servers zeigt (Caddy holt das Zertifikat bei Let's Encrypt)
POOL_DOMAIN=pool.doilabs.org
# E-Mail für Let's Encrypt (Ablaufwarnungen), darf leer bleiben
ACME_EMAIL=

# Stratum-Port nach außen
STRATUM_PORT=3333
# stratum+ssl nach außen (im Container immer 3443, Zertifikat kommt von Caddy); in der Firewall freigeben
STRATUM_TLS_PORT=3443

# RPC-Zugänge zwischen Pool und Nodes (nur im Docker-Netz erreichbar)
BITCOIN_RPC_USER=pool
BITCOIN_RPC_PASSWORD=
DOICHAIN_RPC_USER=pool
DOICHAIN_RPC_PASSWORD=

# Doichain-Adresse des Projekts: bekommt die DOI-Belohnung von Minern ohne DOI-Adresse im Stratum-Passwort
DOICHAIN_DEFAULT_ADDRESS=

# Kennung im Coinbase (max. ca. 20 Zeichen, sonst wird sie weggelassen)
POOL_IDENTIFIER=NerdPool

# Optional: Bitcoin-Adresse für eine Pool-Gebühr von 1,5 % (leer = keine Gebühr)
DEV_FEE_ADDRESS=
# Optional: Telegram-Bot für Blockfund- und Offline-Nachrichten (Miner abonnieren mit /subscribe <BTC-Adresse>,
# Minuten bis zum Offline-Alarm: OFFLINE_ALERT_MINUTES in pool.env)
TELEGRAM_BOT_TOKEN=
# Benutzername des Bots ohne @, wird im Dashboard als Abo-Hinweis gezeigt
TELEGRAM_BOT_USERNAME=
# Optional: Chat- oder Kanal-ID, in die der Bot jeden gefundenen Block meldet (Bot muss Mitglied sein)
TELEGRAM_ANNOUNCE_CHAT_ID=

# Bitcoin Core: pruned auf 20 GB Blockdaten, 1,5 GB Datenbank-Cache (für den Erstabgleich gern höher)
BITCOIN_IMAGE_TAG=29.5
BITCOIN_PRUNE_MB=20000
BITCOIN_DBCACHE_MB=1500

# Dashboard: Beta-Hinweis anzeigen (true/false)
POOL_BETA=true

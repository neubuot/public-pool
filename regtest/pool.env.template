# Pool-Konfiguration für die Regtest-Umgebung (regtest/docker-compose.yml)
BITCOIN_RPC_URL=http://127.0.0.1
BITCOIN_RPC_USER=pool
BITCOIN_RPC_PASSWORD=pool
BITCOIN_RPC_PORT=18443
BITCOIN_RPC_TIMEOUT=10000
BITCOIN_RPC_COOKIEFILE=
BITCOIN_ZMQ_HOST=tcp://127.0.0.1:28332

API_PORT=3334
STRATUM_PORT=3333
STRATUM_MAX_CONNECTIONS_PER_LISTENER=1000

DEV_FEE_ADDRESS=
NETWORK=regtest
API_SECURE=false
POOL_IDENTIFIER="NerdPool-regtest"

# Merged Mining mit Doichain
AUXPOW_ENABLED=true
DOICHAIN_RPC_URL=http://127.0.0.1
DOICHAIN_RPC_PORT=18445
DOICHAIN_RPC_USER=pool
DOICHAIN_RPC_PASSWORD=pool
DOICHAIN_RPC_COOKIEFILE=
DOICHAIN_RPC_TIMEOUT=10000
# Das statische Doichain-Release-Binary ist ohne ZMQ gebaut, der Pool fragt alle 2 s per getblockcount nach
#DOICHAIN_ZMQ_HOST=tcp://127.0.0.1:28334
DOICHAIN_POLL_INTERVAL_MS=2000
DOICHAIN_AUXBLOCK_REFRESH_MS=10000
DOICHAIN_DEFAULT_ADDRESS=__DOI_ADDRESS__
